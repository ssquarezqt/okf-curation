    "description": {
     "type": "doc",
     "version": 1,
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Crear POST /claims. Campos obligatorios: booking_ref, flight_number, delay_minutes, amount."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Aprobación automática si amount <= 250 (AUTO_APPROVE_LIMIT). Por encima, PENDING_REVIEW."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Solo da derecho a compensación un retraso de 180 minutos o más (MIN_DELAY_MINUTES)."
        }
       ]
      }
     ]
    },
